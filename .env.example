# Gemini API Key (server-side only; used by /api/gemini-proxy and Supabase gemini-proxy)
GEMINI_API_KEY=

# Supabase (required for Bites, Scout, Trims service proxies)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spoonacular API Key (Required for Bites page)
# Get yours at: https://spoonacular.com/food-api

# Google Maps API Key (Optional for Scout page)
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# YouTube API Key (Optional for Trims page)
YOUTUBE_API_KEY=

# Local tooling tokens (optional, do not commit real values)
FIGMA_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
SONARQUBE_TOKEN=
